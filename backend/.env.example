# Server
PORT=3000
NODE_ENV=development

# PostgreSQL — use Supabase project ozyjzauukucwasoaotcv's connection string
# (Project Settings → Database → Connection string → URI, "Session pooler" or direct)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase — Project Settings → API
SUPABASE_URL=https://ozyjzauukucwasoaotcv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DOCUMENTS_BUCKET=supplier-documents

# SMS Gateway (Android polling bridge)
SMS_GATEWAY_SECRET=change-me

# CORS: comma-separated list of allowed origins, or leave unset for *
CORS_ORIGIN=

# Only set this if the database is reached through a SOCKS tunnel
# (e.g. Tailscale to a home server). Leave empty for direct connections.
PROXY_URL=
